---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
    title: string;
    description?: string;
    backHref?: string;
}

const { title, description, backHref = "/" } = Astro.props;
---

<BaseLayout title={title} description={description} neutral>
    <main
        class="mx-auto min-h-dvh max-w-[50rem] px-5 py-6 text-neutral-300 sm:px-8 sm:py-10"
    >
        <header class="mb-4 flex items-center gap-3">
            <a
                class="shrink-0 rounded-full p-2 transition-colors hover:bg-neutral-800"
                href={backHref}
                aria-label="前のページへ"
            >
                <Icon name="mdi:arrow-back" size={35} aria-hidden="true" />
            </a>
            <h1 class="my-3 min-w-0 text-3xl font-bold sm:text-4xl">{title}</h1>
        </header>
        <slot />
    </main>
</BaseLayout>
