---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
const { title } = Astro.props;
---

<BaseLayout title={title}>
    <div
        class="bg-slate-700 text-slate-300 max-w-[50rem] mx-auto p-3 h-screen overflow-y-auto scrollbar shadow-2xl scrollbar-thumb-slate-600 scrollbar-track-transparent"
    >
        <div class="flex gap-3 items-center">
            <button
                class="hover:bg-slate-600 transition-colors p-2 rounded-full"
                onclick="history.back()"
            >
                <Icon name="mdi:arrow-back" size={35} />
            </button>
            {
                title && (
                    <h1 class="my-3 text-center text-4xl font-bold">{title}</h1>
                )
            }
        </div>
        <slot />
    </div>
</BaseLayout>

<style is:global>
    @reference "tailwindcss";

    html {
        @apply bg-slate-600 h-screen;
    }
    body {
        @apply h-screen;
    }
</style>
