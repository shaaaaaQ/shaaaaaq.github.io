---
import '../styles/global.css';
import { SITE } from "../consts";

interface Props {
    title?: string;
    description?: string;
    neutral?: boolean;
}

const { title, description = SITE.description, neutral = false } = Astro.props;
const pageTitle = title && title !== SITE.name ? `${title} | ${SITE.name}` : SITE.name;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ja" data-theme={neutral ? "neutral" : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content={neutral ? "#181818" : "#334155"} />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />
        <title>{pageTitle}</title>
        <slot name="head" />
    </head>
    <body>
        <slot />
    </body>
</html>
