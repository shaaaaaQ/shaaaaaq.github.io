---
import BaseLayout from "@layouts/BaseLayout.astro";
import { PROFILE_LINKS, SITE } from "../consts";

const socialLinks = PROFILE_LINKS.filter(({ href }) => href.startsWith("https://"));
const localLinks = PROFILE_LINKS.filter(({ href }) => href.startsWith("/"));
---

<BaseLayout title={SITE.name} neutral>
    <main class="home" aria-label="プロフィール">
        <div class="profile-card">
            <header class="profile">
                <img
                    width="88"
                    height="88"
                    src="/icons/3.png"
                    alt=""
                />
            </header>
            <nav aria-label="プロフィールリンク">
                <ul class="social-links">
                    {socialLinks.map(({ label, href }) => (
                        <li>
                            <a href={href}>
                                <span>{label}</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                    <path d="M6 18 18 6M6 6h12v12" />
                                </svg>
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
            <nav class="local-links" aria-label="サイト内リンク">
                {localLinks.map(({ href }) => (
                    <a href={href}>
                        <span>メモとか</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="M4 12h16m-6-6 6 6-6 6" />
                        </svg>
                    </a>
                ))}
            </nav>
        </div>
    </main>
</BaseLayout>

<style>
    .home {
        display: grid;
        place-items: center;
        min-height: 100svh;
        padding: 4rem 1.5rem;
    }

    .profile-card {
        width: min(100%, 24rem);
        padding: 2.5rem 2.5rem 0.5rem;
        border-radius: 1rem;
        background: #202020;
        box-shadow: 0 4px 12px #00000026, 0 20px 56px #00000059;
    }

    .profile {
        display: flex;
        justify-content: center;
        margin-bottom: 1.75rem;
    }

    img {
        flex-shrink: 0;
        border-radius: 50%;
        outline: 2px solid #555;
        outline-offset: 0;
    }

    a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3rem;
        line-height: 1.5;
    }

    .social-links li + li {
        border-top: 1px solid #303030;
    }

    svg {
        flex-shrink: 0;
        color: #808080;
    }

    a:hover {
        color: #fff;
    }

    a:hover span {
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }

    a:hover svg {
        color: #d4d4d4;
    }

    .local-links {
        margin-top: 1.5rem;
        border-top: 1px solid #383838;
        padding: 0.75rem 0;
        font-size: 0.875rem;
    }

    @media (max-width: 36rem) {
        .home {
            padding: 2rem 1.25rem;
        }

        .profile-card {
            padding: 2rem 1.75rem 0.5rem;
        }
    }
</style>
