---
import BaseLayout from "@layouts/BaseLayout.astro";
import { PROFILE_LINKS, SITE } from "../consts";
---

<BaseLayout title={SITE.name}>
    <main class="flex min-h-dvh p-4">
        <div
            class="m-auto flex h-fit w-fit flex-col items-center gap-10 rounded-md bg-slate-700 p-8 shadow-2xl sm:p-16"
        >
            <img
                class="rounded-full"
                width="120"
                height="120"
                src="/icons/2.png"
                alt="shaaaaaQのアイコン"
            />
            <nav aria-label="プロフィールリンク">
                <ul class="flex flex-col gap-3">
                    {
                        PROFILE_LINKS.map(({ label, href }) => (
                            <li>
                                <a
                                    class="text-xl text-slate-300 transition-opacity hover:opacity-70"
                                    href={href}
                                >
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </main>
</BaseLayout>
